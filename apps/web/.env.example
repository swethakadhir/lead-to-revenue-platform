NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only Dify Community API connection. DIFY_API_URL is the instance API base (for example https://dify.example.com/v1).
DIFY_API_URL=
DIFY_API_KEY=
# Optional; defaults to 8000 and is bounded to 1000-20000.
DIFY_TIMEOUT_MS=8000
# Server-only token for trusted n8n/automation workers. Never expose this to browsers.
AUTOMATION_WORKER_SECRET=
